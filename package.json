    "release": "release-it"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/node": "^26.1.1",
    "release-it": "^20.2.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@slack/types": "^2.22.0",
    "@slack/web-api": "^7.19.0",
    "query-string": "^9.4.1"
  }
